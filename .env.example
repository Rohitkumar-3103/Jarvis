# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to '.env' and insert your keys

# AI Cognitive Provider Keys (Gemini or ChatGPT / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
CHATGPT_KEY=your_openai_or_chatgpt_api_key_here
OPENAI_API_KEY=your_openai_or_chatgpt_api_key_here

# Core HUD customization overrides
ASSISTANT_NAME=JARVIS
USER_NAME=Sir
PORT=8080
HOST=127.0.0.1

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB_NAME=ManualAuth

# Optional Real Email OTP Delivery (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Insert your Gmail and the 16-character App Password below:
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional Real SMS OTP Delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

